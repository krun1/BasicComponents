<#@ template language="C#" hostspecific="true" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#
    const string SourceClass = "DataOrErrorExtension";
    const string SourceFile = SourceClass + ".cs";

    var templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
    var source = File.ReadAllText(Path.Combine(templateDirectory, SourceFile));

    // Retire les commentaires pour ne pas capturer de signatures commentées
    source = Regex.Replace(source, @"//.*?$|/\*.*?\*/", "", RegexOptions.Multiline | RegexOptions.Singleline);

    var methodRegex = new Regex(
        @"(?<attrs>(?:\[[^\[\]]*(?:\[[^\[\]]*\][^\[\]]*)*\]\s*)*)public\s+static\s+(?!class\b)(?<head>[^(;{}]*?)\((?<params>.*?)\)\s*(?<where>where\s[^{;]*?)?\s*(=>|\{)",
        RegexOptions.Singleline);
    var headRegex = new Regex(@"^(?:(?<async>async)\s+)?(?<ret>.+?)\s+(?<name>\w+)\s*(?<gen><.+>)?$", RegexOptions.Singleline);

    var methods = new List<MethodInfo>();
    foreach (Match match in methodRegex.Matches(source))
    {
        var head = Normalize(match.Groups["head"].Value);
        var headMatch = headRegex.Match(head);
        if (!headMatch.Success)
            continue;

        var parameters = SplitTopLevel(Normalize(match.Groups["params"].Value))
            .Select(ParseParameter)
            .ToList();

        // On ne garde que les extensions sur DataOrError<...>
        if (parameters.Count == 0 || !parameters[0].IsThis)
            continue;
        var innerType = GetDataOrErrorArgument(parameters[0].Type);
        if (innerType == null)
            continue;

        methods.Add(new MethodInfo
        {
            Attributes = Regex.Matches(match.Groups["attrs"].Value, @"\[[^\[\]]*(?:\[[^\[\]]*\][^\[\]]*)*\]")
                .Cast<Match>()
                .Select(a => Normalize(a.Value))
                .ToList(),
            IsAsync = headMatch.Groups["async"].Success,
            ReturnType = Normalize(headMatch.Groups["ret"].Value),
            Name = headMatch.Groups["name"].Value,
            Generics = headMatch.Groups["gen"].Success ? Normalize(headMatch.Groups["gen"].Value).Trim('<', '>') : "",
            Where = match.Groups["where"].Success ? " " + Normalize(match.Groups["where"].Value) : "",
            InnerType = innerType,
            Parameters = parameters
        });
    }
#>
// <auto-generated>
//     Généré par DataOrErrorForwardStepExtension.t4 à partir de <#= SourceFile #>.
//     Ne pas modifier ce fichier manuellement.
// </auto-generated>

namespace BasicComponents.Monad;

public static class DataOrErrorForwardStepExtension
{
<#
    for (var i = 0; i < methods.Count; i++)
    {
        var m = methods[i];
        
        if (!m.ReturnType.StartsWith("DataOrError<") && !m.ReturnType.StartsWith("Task<DataOrError<"))
            continue;
        var self = m.Parameters[0];
        var declaration = string.Join(", ", m.Parameters.Select(p => p.Declaration));
        var arguments = string.Join(", ", m.Parameters.Skip(1).Select(p => p.Argument));
        if (i > 0)
            WriteLine("");
        foreach (var attribute in m.Attributes)
            WriteLine("    " + attribute);
#>
<#
        if (m.IsTask)
        {
#>
    public static async <#= m.NewReturnType #> <#= m.Name #><<#= m.Generics #>, TStepResult>(<#= declaration #>)<#= m.Where #>
        => (await <#= self.Name #>.Inner.<#= m.Name #>(<#= arguments #>)).AsStep(<#= self.Name #>.Result);
<#
        }
        else
        {
#>
    public static <#= m.NewReturnType #> <#= m.Name #><<#= m.Generics #>, TStepResult>(<#= declaration #>)<#= m.Where #>
        => <#= self.Name #>.Inner.<#= m.Name #>(<#= arguments #>).AsStep(<#= self.Name #>.Result);
<#
        }
    }
#>
}
<#+
    private class MethodInfo
    {
        public List<string> Attributes;
        public bool IsAsync;
        public string ReturnType;
        public string Name;
        public string Generics;
        public string Where;
        public string InnerType;
        public List<ParameterInfo> Parameters;

        // async ou non, une méthode qui renvoie un Task<...> doit être await avant AsStep
        public bool IsTask => IsAsync || ReturnType.StartsWith("Task<");

        public string NewReturnType => AsStep(ReturnType);
    }

    private class ParameterInfo
    {
        public bool IsThis;
        public string Modifier;
        public string Type;
        public string Name;
        public string Default;

        public string Declaration
            => (IsThis ? "this " : "") + (Modifier != "" ? Modifier + " " : "") + WrittenType + " " + Name + (Default != "" ? " = " + Default : "");

        public string Argument
            => (Modifier == "ref" || Modifier == "out" || Modifier == "in" ? Modifier + " " : "") + Name;

        private string WrittenType => IsThis ? AsStep(Type) : Type;
    }

    private static string AsStep(string s)
    {
        if (s.StartsWith("Task<") && s.EndsWith(">"))
            return $"Task<{AsStep(s.Substring(5, s.Length - 6))}>";
        return s.StartsWith("DataOrError<") ? $"{s}.Step<TStepResult>" : s;
    }
    
    private static string Normalize(string value)
        => Regex.Replace(value, @"\s+", " ").Trim();

    // Découpe sur les virgules qui ne sont pas dans des <>, () ou []
    private static List<string> SplitTopLevel(string value)
    {
        var result = new List<string>();
        if (string.IsNullOrWhiteSpace(value))
            return result;

        var depth = 0;
        var current = new StringBuilder();
        foreach (var c in value)
        {
            if (c == '<' || c == '(' || c == '[') depth++;
            else if (c == '>' || c == ')' || c == ']') depth--;

            if (c == ',' && depth == 0)
            {
                result.Add(current.ToString().Trim());
                current.Clear();
            }
            else
            {
                current.Append(c);
            }
        }
        result.Add(current.ToString().Trim());
        return result;
    }

    private static ParameterInfo ParseParameter(string value)
    {
        var parameter = new ParameterInfo { Modifier = "", Default = "" };

        var equalIndex = IndexOfTopLevel(value, '=');
        if (equalIndex >= 0)
        {
            parameter.Default = value.Substring(equalIndex + 1).Trim();
            value = value.Substring(0, equalIndex).Trim();
        }

        if (value.StartsWith("this "))
        {
            parameter.IsThis = true;
            value = value.Substring(5).Trim();
        }

        foreach (var modifier in new[] { "params", "ref", "out", "in", "scoped" })
        {
            if (value.StartsWith(modifier + " "))
            {
                parameter.Modifier = modifier;
                value = value.Substring(modifier.Length + 1).Trim();
                break;
            }
        }

        var lastSpace = value.LastIndexOf(' ');
        var p = value.Substring(0, lastSpace).Trim();

        parameter.Type = p;
        parameter.Name = value.Substring(lastSpace + 1).Trim();
        return parameter;
    }

    private static int IndexOfTopLevel(string value, char searched)
    {
        var depth = 0;
        for (var i = 0; i < value.Length; i++)
        {
            var c = value[i];
            if (c == '<' || c == '(' || c == '[') depth++;
            else if (c == '>' || c == ')' || c == ']') depth--;
            else if (c == searched && depth == 0 && (i + 1 >= value.Length || value[i + 1] != '>')) return i;
        }
        return -1;
    }

    // DataOrError<X> -> X ; sinon null
    private static string GetDataOrErrorArgument(string type)
    {
        const string prefix = "DataOrError<";
        if (!type.StartsWith(prefix) || !type.EndsWith(">"))
            return null;
        return type.Substring(prefix.Length, type.Length - prefix.Length - 1).Trim();
    }
#>
