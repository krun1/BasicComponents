<#@ template language="C#" hostspecific="true" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#
    // Pour chaque classe static contenant des méthodes d'extension (celles que le compilateur
    // marque avec [Extension]), génère une classe "<Classe>OtherExtension" qui expose chaque
    // méthode marquée [Async] sur Task<T> au lieu de T.
    const string GeneratedSuffix = "OtherExtension";

    var templateFile = Path.GetFullPath(Host.TemplateFile);
    var projectDirectory = Path.GetDirectoryName(templateFile);
    var outputFile = Path.ChangeExtension(templateFile, ".cs");

    var classes = new List<ClassInfo>();
    var usings = new SortedSet<string>(StringComparer.Ordinal);

    var files = Directory.EnumerateFiles(projectDirectory, "*.cs", SearchOption.AllDirectories)
        .Where(f => !IsInFolder(f, projectDirectory, "bin") && !IsInFolder(f, projectDirectory, "obj"))
        .Where(f => !string.Equals(Path.GetFullPath(f), Path.GetFullPath(outputFile), StringComparison.OrdinalIgnoreCase))
        .OrderBy(f => f, StringComparer.Ordinal);

    foreach (var file in files)
    {
        var raw = File.ReadAllText(file);
        if (raw.Contains("<auto-generated>"))
            continue;

        var source = StripComments(raw);
        var namespaces = Regex.Matches(source, @"\bnamespace\s+(?<name>[\w.]+)\s*[;{]").Cast<Match>().ToList();
        var fileClasses = new List<ClassInfo>();

        foreach (Match classMatch in Regex.Matches(source, @"(?<mods>\b(?:(?:public|internal|static|partial|sealed|unsafe)\s+)+)class\s+(?<name>\w+)[^{;]*\{"))
        {
            var modifiers = classMatch.Groups["mods"].Value;
            if (!Regex.IsMatch(modifiers, @"\bstatic\b"))
                continue;

            var bodyStart = classMatch.Index + classMatch.Length;
            var body = source.Substring(bodyStart, FindClosingBrace(source, bodyStart) - bodyStart);
            var methods = ParseMethods(body);

            // Une classe static sans méthode "this" n'a pas l'attribut [Extension]
            if (!methods.Any(m => m.Parameters.Count > 0 && m.Parameters[0].IsThis))
                continue;

            var asyncMethods = methods.Where(m => m.HasAsyncAttribute && m.Parameters.Count > 0 && m.Parameters[0].IsThis).ToList();
            if (asyncMethods.Count == 0)
                continue;

            fileClasses.Add(new ClassInfo
            {
                Visibility = Regex.IsMatch(modifiers, @"\bpublic\b") ? "public" : "internal",
                Name = classMatch.Groups["name"].Value,
                Namespace = namespaces.LastOrDefault(n => n.Index < classMatch.Index)?.Groups["name"].Value ?? "",
                SourceFile = GetRelativePath(projectDirectory, file),
                Methods = asyncMethods
            });
        }

        if (fileClasses.Count == 0)
            continue;

        classes.AddRange(fileClasses);
        foreach (Match usingMatch in Regex.Matches(source, @"^[ \t]*using\s+(?:static\s+)?[\w.]+(?:\s*=\s*[^;]+)?\s*;", RegexOptions.Multiline))
            usings.Add(Normalize(usingMatch.Value));
    }
#>
// <auto-generated>
//     Généré par OtherExtension.t4 à partir des méthodes d'extension marquées [Async].
//     Ne pas modifier ce fichier manuellement.
// </auto-generated>

#nullable enable
<#
    foreach (var u in usings)
        WriteLine(u);
    if (usings.Count > 0)
        WriteLine("");

    var firstNamespace = true;
    foreach (var group in classes.GroupBy(c => c.Namespace))
    {
        if (!firstNamespace)
            WriteLine("");
        firstNamespace = false;

        var hasNamespace = group.Key != "";
        var indent = hasNamespace ? "    " : "";
        if (hasNamespace)
        {
            WriteLine("namespace " + group.Key);
            WriteLine("{");
        }

        var firstClass = true;
        foreach (var c in group)
        {
            if (!firstClass)
                WriteLine("");
            firstClass = false;

            WriteLine(indent + "// Source : " + c.SourceFile);
            WriteLine(indent + c.Visibility + " static class " + c.Name + GeneratedSuffix);
            WriteLine(indent + "{");

            var firstMethod = true;
            foreach (var m in c.Methods)
            {
                if (!firstMethod)
                    WriteLine("");
                firstMethod = false;

                if (m.Parameters.Any(p => p.Modifier == "ref" || p.Modifier == "out" || p.Modifier == "in" || p.Modifier == "scoped") || m.ReturnType.StartsWith("ref "))
                {
                    WriteLine("#warning " + c.Name + "." + m.Name + " : [Async] ignoré, les paramètres ref/out/in ne sont pas supportés dans une méthode async.");
                    continue;
                }

                var self = m.Parameters[0];
                var declaration = string.Join(", ", m.Parameters.Select(p => p.Declaration));
                var arguments = string.Join(", ", m.Parameters.Skip(1).Select(p => p.Name));
                // Les génériques sont passés explicitement : certains ne sont pas inférables (ex: TError)
                var generics = m.Generics != "" ? "<" + m.Generics + ">" : "";
                var call = "(await " + self.Name + ")." + m.Name + generics + "(" + arguments + ")";

                var newName = m.Name.EndsWith("Async") ? m.Name : m.Name + "Async";

                WriteLine(indent + "    " + m.Visibility + " static async " + m.NewReturnType + " " + newName + generics + "(" + declaration + ")" + m.Where);
                WriteLine(indent + "        => " + (m.ReturnsAwaitable ? "await " : "") + call + ";");
            }

            WriteLine(indent + "}");
        }

        if (hasNamespace)
            WriteLine("}");
    }
#>
<#+
    private class ClassInfo
    {
        public string Visibility;
        public string Name;
        public string Namespace;
        public string SourceFile;
        public List<MethodInfo> Methods;
    }

    private class MethodInfo
    {
        public bool HasAsyncAttribute;
        public string Visibility;
        public string ReturnType;
        public string Name;
        public string Generics;
        public string Where;
        public List<ParameterInfo> Parameters;

        // La méthode d'origine renvoie déjà une tâche : on garde son type et on l'await
        public bool ReturnsAwaitable
            => ReturnType == "Task" || ReturnType == "ValueTask"
               || ReturnType.StartsWith("Task<") || ReturnType.StartsWith("ValueTask<");

        public string NewReturnType
            => ReturnsAwaitable ? ReturnType
               : ReturnType == "void" ? "Task"
               : "Task<" + ReturnType + ">";
    }

    private class ParameterInfo
    {
        public bool IsThis;
        public string Modifier;
        public string Type;
        public string Name;
        public string Default;

        public string Declaration
            => (IsThis ? "this Task<" + Type + ">" : (Modifier != "" ? Modifier + " " : "") + Type) + " " + Name + (Default != "" ? " = " + Default : "");
    }

    private static List<MethodInfo> ParseMethods(string body)
    {
        var methodRegex = new Regex(
            @"(?<attrs>(?:\[[^\[\]]*(?:\[[^\[\]]*\][^\[\]]*)*\]\s*)*)(?<vis>public|internal)\s+static\s+(?!class\b)(?<head>[^(;{}=]*?)\((?<params>.*?)\)\s*(?<where>where\s[^{;]*?)?\s*(=>|\{)",
            RegexOptions.Singleline);
        var headRegex = new Regex(@"^(?:(?:async|unsafe|new|extern)\s+)*(?<ret>.+?)\s+(?<name>\w+)\s*(?<gen><.+>)?$", RegexOptions.Singleline);
        var asyncAttributeRegex = new Regex(@"[\[,]\s*(?:[\w.]+\.)?Async(?:Attribute)?\s*(?:\(\s*\))?\s*[\],]");

        var methods = new List<MethodInfo>();
        foreach (Match match in methodRegex.Matches(body))
        {
            var headMatch = headRegex.Match(Normalize(match.Groups["head"].Value));
            if (!headMatch.Success)
                continue;

            methods.Add(new MethodInfo
            {
                HasAsyncAttribute = asyncAttributeRegex.IsMatch(match.Groups["attrs"].Value),
                Visibility = match.Groups["vis"].Value,
                ReturnType = Normalize(headMatch.Groups["ret"].Value),
                Name = headMatch.Groups["name"].Value,
                Generics = headMatch.Groups["gen"].Success ? Normalize(headMatch.Groups["gen"].Value).Trim('<', '>') : "",
                Where = match.Groups["where"].Success ? " " + Normalize(match.Groups["where"].Value) : "",
                Parameters = SplitTopLevel(Normalize(match.Groups["params"].Value)).Select(ParseParameter).ToList()
            });
        }
        return methods;
    }

    private static bool IsInFolder(string file, string root, string folder)
    {
        var relative = GetRelativePath(root, file);
        return relative.StartsWith(folder + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetRelativePath(string root, string file)
    {
        var rootFull = Path.GetFullPath(root).TrimEnd('\\', '/') + Path.DirectorySeparatorChar;
        var fileFull = Path.GetFullPath(file);
        var relative = fileFull.StartsWith(rootFull, StringComparison.OrdinalIgnoreCase) ? fileFull.Substring(rootFull.Length) : fileFull;
        return relative.Replace('\\', '/');
    }

    private static string Normalize(string value)
        => Regex.Replace(value, @"\s+", " ").Trim();

    // Retire les commentaires en préservant les chaînes et caractères littéraux
    private static string StripComments(string source)
    {
        var result = new StringBuilder(source.Length);
        var i = 0;
        while (i < source.Length)
        {
            var c = source[i];
            var next = i + 1 < source.Length ? source[i + 1] : '\0';

            if (c == '/' && next == '/')
            {
                while (i < source.Length && source[i] != '\n')
                    i++;
            }
            else if (c == '/' && next == '*')
            {
                var end = source.IndexOf("*/", i + 2, StringComparison.Ordinal);
                i = end < 0 ? source.Length : end + 2;
                result.Append(' ');
            }
            else if (c == '"' || c == '\'' || (c == '@' && next == '"'))
            {
                var end = SkipLiteral(source, i);
                result.Append(source, i, end - i);
                i = end;
            }
            else
            {
                result.Append(c);
                i++;
            }
        }
        return result.ToString();
    }

    // Renvoie l'index juste après la chaîne/le caractère littéral commençant en start
    private static int SkipLiteral(string source, int start)
    {
        var verbatim = source[start] == '@';
        var i = verbatim ? start + 2 : start + 1;
        var quote = verbatim ? '"' : source[start];
        while (i < source.Length)
        {
            var c = source[i];
            if (verbatim)
            {
                if (c == '"')
                {
                    if (i + 1 < source.Length && source[i + 1] == '"') { i += 2; continue; }
                    return i + 1;
                }
            }
            else
            {
                if (c == '\\') { i += 2; continue; }
                if (c == quote || c == '\n') return i + 1;
            }
            i++;
        }
        return source.Length;
    }

    // Index de l'accolade fermante correspondant à un bloc dont le contenu commence en start
    private static int FindClosingBrace(string source, int start)
    {
        var depth = 1;
        var i = start;
        while (i < source.Length)
        {
            var c = source[i];
            if (c == '"' || c == '\'' || (c == '@' && i + 1 < source.Length && source[i + 1] == '"'))
            {
                i = SkipLiteral(source, i);
                continue;
            }
            if (c == '{') depth++;
            else if (c == '}' && --depth == 0) return i;
            i++;
        }
        return source.Length;
    }

    // Découpe sur les virgules qui ne sont pas dans des <>, () ou []
    private static List<string> SplitTopLevel(string value)
    {
        var result = new List<string>();
        if (string.IsNullOrWhiteSpace(value))
            return result;

        var depth = 0;
        var current = new StringBuilder();
        foreach (var c in value)
        {
            if (c == '<' || c == '(' || c == '[') depth++;
            else if (c == '>' || c == ')' || c == ']') depth--;

            if (c == ',' && depth == 0)
            {
                result.Add(current.ToString().Trim());
                current.Clear();
            }
            else
            {
                current.Append(c);
            }
        }
        result.Add(current.ToString().Trim());
        return result;
    }

    private static ParameterInfo ParseParameter(string value)
    {
        var parameter = new ParameterInfo { Modifier = "", Default = "" };

        // Attributs de paramètre ([CallerMemberName], ...) : non recopiés
        value = Regex.Replace(value, @"^(\[[^\]]*\]\s*)+", "");

        var equalIndex = IndexOfTopLevel(value, '=');
        if (equalIndex >= 0)
        {
            parameter.Default = value.Substring(equalIndex + 1).Trim();
            value = value.Substring(0, equalIndex).Trim();
        }

        if (value.StartsWith("this "))
        {
            parameter.IsThis = true;
            value = value.Substring(5).Trim();
        }

        foreach (var modifier in new[] { "params", "ref", "out", "in", "scoped" })
        {
            if (value.StartsWith(modifier + " "))
            {
                parameter.Modifier = modifier;
                value = value.Substring(modifier.Length + 1).Trim();
                break;
            }
        }

        var lastSpace = value.LastIndexOf(' ');
        parameter.Type = value.Substring(0, lastSpace).Trim();
        parameter.Name = value.Substring(lastSpace + 1).Trim();
        return parameter;
    }

    private static int IndexOfTopLevel(string value, char searched)
    {
        var depth = 0;
        for (var i = 0; i < value.Length; i++)
        {
            var c = value[i];
            if (c == '<' || c == '(' || c == '[') depth++;
            else if (c == '>' || c == ')' || c == ']') depth--;
            else if (c == searched && depth == 0 && (i + 1 >= value.Length || value[i + 1] != '>')) return i;
        }
        return -1;
    }
#>
